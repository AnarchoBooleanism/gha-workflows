{
  // NOTE: This should be able to catch github-actions!

  // Overall Renovate config
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>AnarchoBooleanism/renovate-config#v7.0.1"
  ],

  "ignoreBranches": [
    "/^release-please--/"
  ],

  // Want to make sure that Release Please picks these up
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",

  // Package rule per Release Please package
  "packageRules": [
    {
      "matchFileNames": [
        ".github/workflows/docker-build-runner-image.yaml",
        ".github/workflows/docker-smoke-check.yaml"
      ],
      "semanticCommitScope": "docker-build-runner-image",
      "groupName": "docker-build-runner-image dependencies"
    },
    {
      "matchFileNames": [
        ".github/workflows/docker-multiarch-build.yaml",
        ".github/workflows/docker-multiarch-merge-push.yaml",
        ".github/workflows/docker-multiarch-validate-versioning.yaml"
      ],
      "semanticCommitScope": "docker-multiarch",
      "groupName": "docker-multiarch dependencies"
    },

    // Make sure internal workflows aren't picked up on
    {
      "matchFileNames": [
        ".github/workflows/internal-*.yaml"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    }
  ]
}
